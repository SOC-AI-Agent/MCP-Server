# soc-mcp-server — skeleton for a LOCAL .env.
#
#   cp .env.local.example .env       # then fill in every blank below
#   docker compose up -d --build
#   docker compose exec -T soc-mcp-splunk     python check_connection.py
#   docker compose exec -T soc-mcp-threatq    python check_connection.py
#   docker compose exec -T soc-mcp-confluence python check_connection.py
#
# .env is gitignored — never commit it. A deploy does not use this file: the
# pipeline builds .env from .env.example and the GitLab CI variables.
#
# Splunk, ThreatQ and Confluence are NOT in this Docker network. They are on the
# company network and are reached at the URLs below, so this machine needs a route
# and an open port to each, DNS for their names, and their CA if it is internal
# (README.md, "Platforms outside Docker").
#
# Only what has no default is listed. Everything else in .env.example (timeouts,
# paths, ports, allowed hosts) is fine as it is. tests/test_env_files.py keeps the
# two files from drifting apart.


# ── Ours: generate these, nobody has to provide them ───────────────────────────
# One different value each:  openssl rand -hex 32
# Each must ALSO be set, byte for byte, in Backend/.env (same names) and in
# LLM-Server/.env (the "token" of the matching entry in MCP_SERVERS). A mismatch
# is a 401 that says nothing. Backend/deploy/dev-setup.sh writes all of them at once.
MCP_AUTH_TOKEN=
THREATQ_MCP_AUTH_TOKEN=
CONFLUENCE_MCP_AUTH_TOKEN=


# ── TLS: the company CA ────────────────────────────────────────────────────────
# Only if a platform's certificate is signed by an internal CA. Put the PEM in
# certs/ (all the CAs the three platforms chain to, in one file) and name it here.
# It REPLACES the built-in CA list. Blank = built-in list.
# Leave every *_VERIFY_SSL below at true.
SSL_CERT_FILE=
#SSL_CERT_FILE=/certs/company-ca.pem


# ── Splunk ─────────────────────────────────────────────────────────────────────
# From the Splunk team: the management URL, a token whose role can run searches
# and see the indexes below, and which indexes those are. The token is sent as
# "Authorization: Bearer". Token authentication has to be enabled by an admin, and
# the account creating the token needs edit_tokens_own or edit_tokens_all. Ask for
# its expiry date.
# e.g. https://splunk.corp.example:8089  — the management port, not the web UI (8000)
SPLUNK_BASE_URL=
SPLUNK_TOKEN=
# Comma-separated. Every search is confined to these. There is no default.
SPLUNK_ALLOWED_INDEXES=
SPLUNK_VERIFY_SSL=true


# ── ThreatQ ────────────────────────────────────────────────────────────────────
# From the ThreatQ team: the URL and a READ-ONLY service account. ThreatQ
# permissions are per endpoint, so it needs read on indicators AND on
# indicators_search (the lookup uses the search endpoint).
# e.g. https://threatq.corp.example
THREATQ_BASE_URL=
THREATQ_VERIFY_SSL=true
# oauth is the documented method (POST /api/token?grant_type=password&client_id=…).
# bearer (a static token) is not described in ThreatQ's REST reference: use it only
# if the ThreatQ team confirms such a token exists.
THREATQ_AUTH_MODE=oauth

# oauth: the client_id is published at https://<threatq>/assets/js/config.js
THREATQ_CLIENT_ID=
THREATQ_EMAIL=
THREATQ_PASSWORD=

# bearer: only when THREATQ_AUTH_MODE=bearer
THREATQ_TOKEN=


# ── Confluence ─────────────────────────────────────────────────────────────────
# From the Confluence team: the URL, the key of the space the playbooks live in,
# and a service account with view permission on that space only (an API token or
# personal access token carries that account's permissions, nothing narrower).
# e.g. https://wiki.corp.example  — Atlassian Cloud needs /wiki on the end
CONFLUENCE_BASE_URL=
CONFLUENCE_SPACE_KEY=
# Cloud: the account's email, with an API token. Data Center / Server 7.9+: leave the
# email blank and put a personal access token in CONFLUENCE_API_TOKEN; ask for its
# expiry date.
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
