# soc-mcp-splunk — skeleton for a LOCAL .env.
#
#   cp .env.local.example .env       # then fill in the blanks below
#   docker compose up -d --build
#
# .env is gitignored — never commit it. This service is for development only and
# is not deployed.
#
# ThreatQ and Confluence are not here any more: the backend calls them directly,
# with their credentials in Backend/.env.
#
# Only what has no default is listed. Everything else in .env.example (timeouts,
# paths, ports, allowed hosts) is fine as it is. tests/test_env_files.py keeps the
# two files from drifting apart.


# ── Mode ───────────────────────────────────────────────────────────────────────
# mock = answer from a fixed set of events; needs nothing in the Splunk section.
# live = run searches against SPLUNK_BASE_URL (for /catalog and /check-connection).
SPLUNK_MODE=mock


# ── Ours: generate this, nobody has to provide it ──────────────────────────────
#   openssl rand -hex 32
# Must ALSO be set, byte for byte, in Backend/.env (same name). A mismatch is a 401
# that says nothing. Backend/deploy/dev-setup.sh writes both at once.
MCP_AUTH_TOKEN=


# ── live only ──────────────────────────────────────────────────────────────────
# Splunk is NOT in this Docker network. It is on the company network and reached at
# the URL below, so this machine needs a route and an open port to it, DNS for its
# name, and its CA if it is internal (README.md, "Platforms outside Docker").
#
# Only if Splunk's certificate is signed by an internal CA: put the PEM in certs/
# and name it here. It REPLACES the built-in CA list. Blank = built-in list.
# Leave SPLUNK_VERIFY_SSL at true.
SSL_CERT_FILE=
#SSL_CERT_FILE=/certs/company-ca.pem

# The management port (8089), not the web UI.
SPLUNK_BASE_URL=
# A Splunk authentication token for a search-only role (Settings > Tokens).
SPLUNK_TOKEN=
# The indexes searches are confined to, comma-separated. Same list as Backend/.env.
SPLUNK_ALLOWED_INDEXES=
SPLUNK_VERIFY_SSL=true
