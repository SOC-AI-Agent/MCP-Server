# ========== TLS (live mode) ==========
# Splunk is outside this Docker network, on the company network, and is reached at
# SPLUNK_BASE_URL. If its certificate is signed by an internal CA the container does
# not trust it, and every check fails at "reach" with "certificate verify failed".
# Put the CA in certs/ (a PEM) and name it here:
#   SSL_CERT_FILE=/certs/company-ca.pem
# It REPLACES the built-in CA list. Blank keeps the built-in list. Do not turn
# SPLUNK_VERIFY_SSL off instead.
SSL_CERT_FILE=

# ---------- soc-mcp-splunk ----------
# Splunk for the backend, over MCP. The backend sends each requirement to
# splunk_lookup; this service builds the prompt, has Text-to-SPL write the search,
# checks it is read-only, runs it and returns the SPL and the rows. No model runs
# here. See Splunk/README.md.
#
# mock = answer from a fixed set of events, Text-to-SPL is a template; needs none
#        of the SPLUNK_* credentials below. For development.
# live = searches run against SPLUNK_BASE_URL: the Splunk container in
#        external/splunk (its setup.py prints these values), or the company's.
SPLUNK_MODE=mock
# Bearer token the backend presents.
# Generate: openssl rand -hex 32. Must match Backend/.env byte for byte.
# Unset = refuses to start.
MCP_AUTH_TOKEN=
# Host headers the MCP endpoint accepts (DNS-rebinding defence).
MCP_ALLOWED_HOSTS=soc-mcp-splunk:8200,localhost:8200,127.0.0.1:8200
# The management URL — port 8089, not the web UI on 8000.
# e.g. https://splunk.corp.example:8089, or https://soc-splunk:8089 (the container)
SPLUNK_BASE_URL=
# A Splunk authentication token, sent as "Authorization: Bearer", for a
# SEARCH-ONLY role scoped to the indexes below. Never a username and password.
# The Splunk admin enables token authentication and creates it for a service user
# (the creating account needs the edit_tokens_own or edit_tokens_all capability).
# Ask for its expiry date.
SPLUNK_TOKEN=
# Comma-separated index allowlist every search is confined to. "*" disables the
# restriction and has to be typed out on purpose. No default: unset = refuses to start.
SPLUNK_ALLOWED_INDEXES=
# Set false only for a self-signed lab cert (the container in external/splunk).
SPLUNK_VERIFY_SSL=true
SPLUNK_TIMEOUT=60
# Hard ceiling on rows returned to a caller, whatever it asks for.
SPLUNK_MAX_COUNT=200
# Where fired alerts are and the field holding their name, told to Text-to-SPL for
# "how often has this alert fired". Splunk ES defaults; a plain Splunk install differs.
SPLUNK_ALERT_INDEX=notable
SPLUNK_ALERT_NAME_FIELD=search_name

# ---------- Text-to-SPL by Splunk AI Assistant (optional, live only) ----------
# Splunk's own MCP Server app: https://<splunk>:8089/services/mcp (a bare base URL
# gets /services/mcp added). Set = each request is forwarded to its Text-to-SPL
# tool, and the text is processed by Splunk AI Assistant in Splunk Cloud.
# Blank = a template writes the SPL. A plain Splunk container has no assistant:
# leave it blank there.
SPLUNK_SAIA_MCP_URL=
# The encrypted token from the Splunk MCP Server app (audience "mcp").
# Blank = SPLUNK_TOKEN is sent.
SPLUNK_SAIA_MCP_TOKEN=
# The tool's name, and which of its arguments takes the text (blank = read from
# the tool's schema). Change only if Splunk renames them.
SPLUNK_SAIA_TOOL=saia_generate_spl
SPLUNK_SAIA_ARG=
MCP_PORT=8200

# ---------- soc-mcp-confluence ----------
# Confluence over MCP: the playbook space, read-only. Holds the Confluence
# credentials and reads pages; it does not decide what a page means. Not started
# by a plain `docker compose up` — `docker compose --profile confluence up -d`.
# There is no mock: unset base URL, token or space = refuses to start.
# See Confluence/README.md.
#
# Bearer token a caller presents. Its own, not MCP_AUTH_TOKEN: one stolen token
# should not open both connectors. Generate: openssl rand -hex 32
CONFLUENCE_MCP_AUTH_TOKEN=ATATT3xFfGF0eNAKftYkFm4d16cXAjM6-kzJxtPHzkBPr82-kR2pgH3T6Gb3MjQ5TLzo_E6tYNlKvkz_fmZvaZjKbPhg72YUg1QClvaXbkW509Y8PysJmLfApU9snQ-mFJVvOeYTn-nUnLYYziv0RaJgrD5w3x2cPRaWghZGd3_7jIFwooDLako=56567D48
# Host headers the MCP endpoint accepts (DNS-rebinding defence).
CONFLUENCE_MCP_ALLOWED_HOSTS=soc-mcp-confluence:8600,localhost:8600,127.0.0.1:8600
CONFLUENCE_MCP_PORT=8600
#   Cloud:     https://your-org.atlassian.net/wiki
#   Server/DC: https://confluence.corp.example
# Or an address as the browser shows it — the site and the space key are taken
# from it (the key wins over CONFLUENCE_SPACE_KEY), and it says what is read:
#   .../wiki/spaces/SOC/overview                  the whole space
#   .../wiki/spaces/SOC/pages/123456/Use+Cases    that page and every page under it
#   .../wiki/spaces/SOC/folder/123456             every page in that folder
# The same values as Backend/.env, which reads the same space.
CONFLUENCE_BASE_URL=
# Only when CONFLUENCE_BASE_URL is the bare site: the part after /spaces/ in the
# space's address.
CONFLUENCE_SPACE_KEY=
# Cloud: the account's email + an API token (basic auth).
# Server/DC: leave the email blank and put a personal access token below (bearer).
# A read-only account that can see only the playbook space.
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
# Which REST API. auto: v2 for *.atlassian.net (Cloud), v1 for anything else
# (Server/DC has only v1). v1 or v2 forces one.
CONFLUENCE_API=auto
# v1 only: appended to the base URL. /rest/api for Server/DC.
CONFLUENCE_API_PATH=/rest/api
# Pages per request (v2 takes at most 250); the space is paged through to the end.
CONFLUENCE_PAGE_LIMIT=200
# An HTTP proxy for the Confluence calls. Blank: direct. For Cloud from a host
# that reaches the internet only through the office proxy: http://host:port
CONFLUENCE_PROXY=
# Set false only for a self-signed lab cert. For an internal CA use SSL_CERT_FILE above.
CONFLUENCE_VERIFY_SSL=true
CONFLUENCE_TIMEOUT=60
