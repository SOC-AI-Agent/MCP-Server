# ========== TLS (live mode) ==========
# Splunk is outside this Docker network, on the company network, and is reached at
# SPLUNK_BASE_URL. If its certificate is signed by an internal CA the container does
# not trust it, and every check fails at "reach" with "certificate verify failed".
# Put the CA in certs/ (a PEM) and name it here:
#   SSL_CERT_FILE=/certs/company-ca.pem
# It REPLACES the built-in CA list. Blank keeps the built-in list. Do not turn
# SPLUNK_VERIFY_SSL off instead.
SSL_CERT_FILE=

# ---------- soc-mcp-splunk ----------
# An MCP server shaped like Splunk's own (tools saia_generate_spl and
# splunk_run_query at /services/mcp). The backend sends each Splunk requirement as
# text, gets SPL back, and runs it. No model runs here. See Splunk/README.md.
#
# mock = answer from a fixed set of events, Text-to-SPL is a template; needs none
#        of the SPLUNK_* credentials below. For development.
# live = splunk_run_query runs against SPLUNK_BASE_URL. Text-to-SPL is not here:
#        in production the backend talks to Splunk's own MCP server directly.
SPLUNK_MODE=mock
# Bearer token the backend presents.
# Generate: openssl rand -hex 32. Must match Backend/.env byte for byte.
# Unset = refuses to start.
MCP_AUTH_TOKEN=
# Host headers the MCP endpoint accepts (DNS-rebinding defence).
MCP_ALLOWED_HOSTS=soc-mcp-splunk:8200,localhost:8200,127.0.0.1:8200
# The management URL — port 8089, not the web UI on 8000.
# e.g. https://splunk.corp.example:8089
SPLUNK_BASE_URL=
# A Splunk authentication token, sent as "Authorization: Bearer", for a
# SEARCH-ONLY role scoped to the indexes below. Never a username and password.
# The Splunk admin enables token authentication and creates it for a service user
# (the creating account needs the edit_tokens_own or edit_tokens_all capability).
# Ask for its expiry date.
SPLUNK_TOKEN=
# Comma-separated index allowlist every search is confined to. "*" disables the
# restriction and has to be typed out on purpose. No default: unset = refuses to start.
# Set the same list in Backend/.env — it builds the searches, this checks them.
SPLUNK_ALLOWED_INDEXES=
# Set false only for a self-signed lab cert.
SPLUNK_VERIFY_SSL=true
SPLUNK_TIMEOUT=60
# Hard ceiling on rows returned to a caller, whatever it asks for.
SPLUNK_MAX_COUNT=200
MCP_PORT=8200
