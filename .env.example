# soc-mcp-server — the settings the three connectors read, and only those.
#
# Local run: `cp .env.example .env`, or start from .env.local.example, which lists
# only what has no default. Deploy: the pipeline builds .env from THIS file plus
# the GitLab CI variables — a key has to be listed here to be picked up, and one
# with no CI variable keeps the value written here. So no real secret goes in this
# file, and a secret left blank here stops the connector starting instead of
# starting on a guessable value.

# ========== ALL CONNECTORS ==========
# Splunk, ThreatQ and Confluence are outside this Docker network, on the company
# network, and are reached by the URLs below. If their certificates are signed by
# an internal CA the containers do not trust it, and every check fails at "reach"
# with "certificate verify failed". Put the CA in certs/ (a PEM, several
# concatenated if the platforms use different ones) and name it here:
#   SSL_CERT_FILE=/certs/company-ca.pem
# It REPLACES the built-in CA list, so it must hold every CA the three platforms
# chain to. Blank keeps the built-in list. Do not turn *_VERIFY_SSL off instead —
# the deploy job refuses that.
SSL_CERT_FILE=

# ---------- soc-mcp-splunk ----------
# A plain HTTP API for the backend — no MCP layer, no model. The MCP_ prefix is the
# name it had as an MCP server. Bearer token the backend presents; its own, not the
# other connectors'. Generate: openssl rand -hex 32
# Must match Backend/.env byte for byte. Unset = refuses to start.
MCP_AUTH_TOKEN=
# The management URL — port 8089, not the web UI on 8000.
# e.g. https://splunk.corp.example:8089
SPLUNK_BASE_URL=
# A Splunk authentication token, sent as "Authorization: Bearer", for a
# SEARCH-ONLY role scoped to the indexes below. Never a username and password.
# The Splunk admin enables token authentication and creates it for a service user
# (the creating account needs the edit_tokens_own or edit_tokens_all capability).
# Ask for its expiry date.
SPLUNK_TOKEN=
# Comma-separated index allowlist every search is confined to. "*" disables the
# restriction and has to be typed out on purpose. No default: unset = refuses to start.
SPLUNK_ALLOWED_INDEXES=
# Set false only for a self-signed lab cert. The deploy job refuses false.
SPLUNK_VERIFY_SSL=true
SPLUNK_TIMEOUT=60
# Hard ceiling on rows returned to a caller, whatever it asks for.
SPLUNK_MAX_COUNT=200
# Splunk ES defaults; a plain Splunk install differs.
SPLUNK_ALERT_INDEX=notable
SPLUNK_ALERT_NAME_FIELD=search_name
MCP_PORT=8200

# ---------- soc-mcp-threatq ----------
# Indicator reputation from the real ThreatQ — there is no stand-in. Once it is up,
# GET /check-connection says whether ThreatQ is usable. See Threatq/README.md.
# Bearer token callers present to this connector. Generate: openssl rand -hex 32
# Must match Backend/.env and LLM-Server/.env byte for byte. Unset = refuses to start.
THREATQ_MCP_AUTH_TOKEN=
# The appliance's address, no trailing path. e.g. https://threatq.corp.example
THREATQ_BASE_URL=
# Looking an indicator up by value is a search: GET /api/indicators has no
# value filter (REST API Reference v5.12).
THREATQ_SEARCH_PATH=/api/indicators/search
# Score, sources and adversaries are related objects and are ABSENT unless named
# here. Without this every indicator comes back looking unscored.
THREATQ_SEARCH_WITH=score,sources,adversaries,status,type,attributes
# What /check-connection reads (one row) to prove the account can read indicators.
THREATQ_CHECK_PATH=/api/indicators
# oauth = ThreatQ's documented token request: POST /api/token?grant_type=password
# &client_id=… with the email and password (THREATQ_TOKEN_PATH).
# bearer = a static token in THREATQ_TOKEN. The REST reference does not describe
# one, so use it only if the ThreatQ team confirms it exists.
THREATQ_AUTH_MODE=oauth
# oauth: the client_id is published at https://<threatq>/assets/js/config.js
# The account must be READ-ONLY. ThreatQ permissions are per endpoint: it needs
# read on indicators (what /check-connection reads) and on indicators_search
# (what a lookup uses) — a role can hold one without the other.
THREATQ_CLIENT_ID=
THREATQ_EMAIL=
THREATQ_PASSWORD=
# bearer only:
THREATQ_TOKEN=
THREATQ_VERIFY_SSL=true
THREATQ_TIMEOUT=60
THREATQ_MCP_PORT=8300
THREATQ_MCP_ALLOWED_HOSTS=soc-mcp-threatq:8300,localhost:8300,127.0.0.1:8300

# ---------- soc-mcp-confluence ----------
# Which runbook covers an alert, read from a real Confluence space. There is no
# sample-playbook fallback: without a URL and a token the connector refuses to start.
# Bearer token callers present to this connector. Generate: openssl rand -hex 32
# Must match Backend/.env and LLM-Server/.env byte for byte. Unset = refuses to start.
CONFLUENCE_MCP_AUTH_TOKEN=
# Cloud: https://<site>.atlassian.net/wiki — the /wiki is part of the URL.
# Data Center / Server: the instance's base URL, e.g. https://wiki.corp.example
CONFLUENCE_BASE_URL=
CONFLUENCE_SPACE_KEY=
# Cloud: the account's email, used with an API token (basic auth).
# Data Center / Server 7.9+: leave the email blank and put a personal access token
# in CONFLUENCE_API_TOKEN (sent as a Bearer). Either carries the permissions of the
# account that owns it, so use a service account with view on the playbook space
# only. A personal access token can expire — ask for the date.
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
