meta {
  name: Guard - SPL injection in a value
  type: http
  seq: 9
}

post {
  url: {{mcp_splunk}}/mcp
  body: json
  auth: none
}

headers {
  Accept: application/json, text/event-stream
  Authorization: Bearer {{mcp_splunk_token}}
  Content-Type: application/json
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 5,
    "method": "tools/call",
    "params": {
      "name": "search_events",
      "arguments": {
        "index": "main",
        "filters": {
          "action": "blocked\" | delete | head 1"
        },
        "max_count": 2
      }
    }
  }
}

tests {
  // The payload is JSON inside an SSE frame inside JSON, so decode before
  // asserting. Counting backslashes in the raw text proves nothing.
  const line = res.getBody().split("\n").find(function (l) {
    return l.startsWith("data:");
  });
  const rpc = JSON.parse(line.slice(5));
  const payload = JSON.parse(rpc.result.content[0].text);
  test("the quote was escaped, so | delete stays inside the value", function() {
    expect(payload.spl).to.include('action="blocked\\" | delete');
  });
  test("nothing matched the literal", function() {
    expect(payload.count).to.equal(0);
  });
}

docs {
  Read the `spl` in the reply, not the count. The quote must come back escaped, leaving `| delete` as text inside a quoted value rather than a command. A count of 0 alone proves nothing — it is also what a search that ran and matched nothing returns.
}
