meta {
  name: Guard - index outside the allowlist
  type: http
  seq: 8
}

post {
  url: {{mcp_splunk}}/mcp
  body: json
  auth: none
}

headers {
  Accept: application/json, text/event-stream
  Authorization: Bearer {{mcp_splunk_token}}
  Content-Type: application/json
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 4,
    "method": "tools/call",
    "params": {
      "name": "search_events",
      "arguments": {
        "index": "_internal",
        "max_count": 1
      }
    }
  }
}

tests {
  test("refused", function() {
    expect(res.getBody()).to.include("is not allowed");
  });
}

docs {
  Must come back as a tool error naming the permitted indexes.
}
