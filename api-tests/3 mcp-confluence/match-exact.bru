meta {
  name: Match — exact name
  type: http
  seq: 2
}

post {
  url: {{mcp_confluence}}/match
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{mcp_confluence_token}}
  Content-Type: application/json
}

body:json {
  {
    "alert_name": "Malware detected in downloaded file"
  }
}

tests {
  test("200", function() { expect(res.getStatus()).to.equal(200); });
  test("matched exactly", function() {
    expect(res.getBody().matched).to.equal(true);
    expect(res.getBody().how).to.equal("exact");
  });
  test("carries the triage criteria", function() {
    const pb = res.getBody().playbook;
    expect(pb.true_condition).to.be.a("string").and.not.empty;
    expect(pb.false_condition).to.be.a("string").and.not.empty;
  });
  test("splunk_query is parameters, not SPL", function() {
    const q = res.getBody().playbook.splunk_query;
    if (q) {
      expect(q).to.be.an("object");
      expect(JSON.stringify(q)).to.not.match(/\|\s*(delete|collect|outputlookup|script)/i);
    }
  });
}

docs {
  The normal path. `how: "exact"` after case and spacing are folded.

  true_condition and false_condition are the reason this call exists: they are
  what a log cannot tell you, and without them a suggestion can say what
  happened and not whether it matters.
}
