meta {
  name: Sync now
  type: http
  seq: 7
}

post {
  url: {{mcp_confluence}}/sync
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{mcp_confluence_token}}
}

tests {
  test("200", function() { expect(res.getStatus()).to.equal(200); });
  test("reports what it loaded", function() {
    expect(res.getBody().count).to.be.a("number");
  });
  test("reports name conflicts", function() {
    expect(res.getBody()).to.have.property("conflicts");
  });
}

docs {
  Forces a re-read instead of waiting for SYNC_INTERVAL_MINUTES. Run it after
  editing a playbook page.

  `conflicts` lists names claimed by two playbooks. They are reported rather
  than resolved by load order — whichever page loaded second is not an answer,
  and one of the two will never be reached.

  A failed sync keeps the previous corpus and returns `error`. Serving
  yesterday's playbooks beats serving none.
}
