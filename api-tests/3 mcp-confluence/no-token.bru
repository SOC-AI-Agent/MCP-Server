meta {
  name: Match — no token
  type: http
  seq: 6
}

post {
  url: {{mcp_confluence}}/match
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "alert_name": "Malware detected in downloaded file"
  }
}

tests {
  test("401", function() { expect(res.getStatus()).to.equal(401); });
}

docs {
  Its own token, not the Splunk or ThreatQ connector's — one stolen token
  should not open all three. /health is the only unauthenticated path.
}
