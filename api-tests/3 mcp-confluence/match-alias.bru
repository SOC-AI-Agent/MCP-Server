meta {
  name: Match — by alias
  type: http
  seq: 3
}

post {
  url: {{mcp_confluence}}/match
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{mcp_confluence_token}}
  Content-Type: application/json
}

body:json {
  {
    "alert_name": "Virus detected"
  }
}

tests {
  test("200", function() { expect(res.getStatus()).to.equal(200); });
  test("resolves the alias to its playbook", function() {
    expect(res.getBody().matched).to.equal(true);
    expect(res.getBody().playbook.alert_name).to.not.equal("Virus detected");
  });
}

docs {
  FortiSOAR and Confluence do not always agree on a detection's name, and
  detections get renamed without the playbook following. Aliases are the
  mechanism; this proves one resolves.

  Try "T1110" too — MITRE technique IDs work as aliases because dots and
  hyphens survive normalisation.
}
