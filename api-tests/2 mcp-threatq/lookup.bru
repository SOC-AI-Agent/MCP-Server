meta {
  name: Lookup - many at once
  type: http
  seq: 2
}

post {
  url: {{mcp_threatq}}/lookup
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{mcp_threatq_token}}
  Content-Type: application/json
}

body:json {
  {
    "indicators": [
      {
        "type": "ip",
        "value": "45.83.122.9"
      },
      {
        "type": "domain",
        "value": "cdn.example.com"
      }
    ]
  }
}

tests {
  test("responds 2xx", function() {
    expect(res.getStatus()).to.be.within(200, 300);
  });
  test("reports what it checked", function() {
    expect(res.getBody()).to.have.property("checked");
  });
}

docs {
  What the worker calls for every alert, before any model runs.
  
  `found: false` means ThreatQ has no record. That is UNKNOWN, not clean.
}
