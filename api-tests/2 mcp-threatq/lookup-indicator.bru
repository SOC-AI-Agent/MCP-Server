meta {
  name: Tools - lookup_indicator
  type: http
  seq: 6
}

post {
  url: {{mcp_threatq}}/mcp
  body: json
  auth: none
}

headers {
  Accept: application/json, text/event-stream
  Authorization: Bearer {{mcp_threatq_token}}
  Content-Type: application/json
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 2,
    "method": "tools/call",
    "params": {
      "name": "lookup_indicator",
      "arguments": {
        "value": "45.83.122.9",
        "indicator_type": "ip"
      }
    }
  }
}

tests {
  test("responds 2xx", function() {
    expect(res.getStatus()).to.be.within(200, 300);
  });
}

docs {
  For an indicator that turned up mid-analysis — one a log search returned, which enrichment never saw.
}
