meta {
  name: Lookup without a token (must fail)
  type: http
  seq: 3
}

post {
  url: {{mcp_threatq}}/lookup
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "indicators": [
      {
        "type": "ip",
        "value": "1.1.1.1"
      }
    ]
  }
}

tests {
  test("401", function() { expect(res.getStatus()).to.equal(401); });
}
