meta {
  name: Tools - an indicator with no record
  type: http
  seq: 7
}

post {
  url: {{mcp_threatq}}/mcp
  body: json
  auth: none
}

headers {
  Accept: application/json, text/event-stream
  Authorization: Bearer {{mcp_threatq_token}}
  Content-Type: application/json
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 3,
    "method": "tools/call",
    "params": {
      "name": "lookup_indicator",
      "arguments": {
        "value": "203.0.113.9",
        "indicator_type": "ip"
      }
    }
  }
}

tests {
  test("responds 2xx", function() {
    expect(res.getStatus()).to.be.within(200, 300);
  });
  test("says unknown, not clean", function() {
    expect(res.getBody()).to.include("unknown, not safe");
  });
}

docs {
  The reply must say unknown rather than clean.
}
