# soc-splunk — the Splunk container. cp .env.example .env
#
# The admin password, for the web UI (http://localhost:8000, user admin) and for
# setup.py. At least 8 characters. Generate: openssl rand -hex 12
# soc-mcp-splunk never sees it: it uses the token setup.py creates.
SPLUNK_PASSWORD=

# splunk/splunk image tag. Blank = latest.
SPLUNK_IMAGE_TAG=
# Ports on this machine, if 8000 or 8089 are taken.
SPLUNK_WEB_PORT=8000
SPLUNK_MGMT_PORT=8089
