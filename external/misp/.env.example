# soc-misp — the MISP container. cp .env.example .env, then fill each secret:
#   openssl rand -hex 16   (passwords, ENCRYPTION_KEY)
#   openssl rand -hex 20   (ADMIN_KEY: exactly 40 hex characters)

# Web UI login (http://localhost:8095): ADMIN_EMAIL / ADMIN_PASSWORD.
# At least 12 characters with upper, lower, digit and symbol, or MISP refuses it.
ADMIN_EMAIL=admin@soc-lab.local
ADMIN_PASSWORD=
# The admin's API key. setup.py uses it once, to create a read-only user for
# the Backend; the Backend never gets this one.
ADMIN_KEY=
ADMIN_ORG=SOC-Lab

# Encrypts secrets stored in MISP's database. Set once; changing it later breaks them.
ENCRYPTION_KEY=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=

# The URL MISP builds its own links with. On a VPS: http://<VPS_IP>:8095
MISP_BASE_URL_PUBLIC=http://localhost:8095
# Where the web UI listens on this machine. 127.0.0.1 = this machine only;
# on a VPS set 0.0.0.0 only behind a firewall allowlist.
MISP_BIND=127.0.0.1
MISP_HTTP_PORT=8095
# misp-core / misp-nginx image tag (ghcr.io/misp/misp-docker).
MISP_TAG=v2.5.51
